# Gemini Configuration (Single or Multiple Keys for Automatic Rotation)
GEMINI_API_KEY=your_primary_gemini_api_key_here
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Generation & Embedding Models (Optional overrides)
# GEMINI_GENERATION_MODEL=gemini-3.7-flash
# GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Qdrant Vector DB Configuration
# Storage Modes: 'cloud' (online Qdrant Cloud), 'local' (embedded disk storage), 'server' (local docker/service), 'auto' (fallback)
QDRANT_MODE=cloud
QDRANT_URL=https://76aa7355-4c1e-4d7e-b301-ec5c2b4dae96.eu-west-2-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_PATH=./qdrant_db
QDRANT_COLLECTION=industrial_sops_v2

